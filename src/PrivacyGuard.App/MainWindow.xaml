<Window x:Class="PrivacyGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Privacy Guard — R4.2 一括出力・比較レビュー" Height="850" Width="1510"
        MinHeight="685" MinWidth="1100"
        Background="#151820" Foreground="#E8E8EE"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#202530" Padding="16,12">
            <StackPanel>
                <TextBlock FontSize="21" FontWeight="SemiBold" Text="AI Privacy Guard"/>
                <TextBlock Foreground="#AEB7C7" FontSize="12"
                           Text="R4.2 / SHA-256動画確認・加工前後比較 | 専用AIモデル未同梱・配信には使用しない"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#202530" Padding="12,9">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#AEE7E4"/>
        </Border>
        <TabControl x:Name="MainTabs" Background="#151820" Foreground="#E8E8EE" BorderThickness="0">
            <TabItem x:Name="ImageTab" Header="画像・確認キュー">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="210"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <WrapPanel>
                            <Button Content="画像を開く" Click="OpenImage_Click"/>
                            <Button Content="模擬検出を追加" Click="AddMock_Click"/>
                            <Button x:Name="InstallRecommendedModelButton" Content="露出検出AIを導入（NudeNet）" Click="InstallRecommendedModel_Click"/>
                            <Button x:Name="LoadModelButton" Content="AIモデル定義を開く" Click="LoadModel_Click"/>
                            <Button x:Name="DetectButton" Content="AIで候補を抽出" Click="DetectImage_Click"/>
                            <Button x:Name="ModelProbeButton" Content="モデル接続診断" Click="ModelProbe_Click" IsEnabled="False"/>
                            <Button x:Name="ExportProbeButton" Content="診断JSONを保存" Click="ExportProbe_Click" IsEnabled="False"/>
                            <Button Content="AI解析を停止" Click="CancelDetection_Click"/>
                            <Button Content="手動で範囲指定" Click="Manual_Click"/>
                            <Button Content="範囲編集を元に戻す" Click="UndoRegion_Click"/>
                            <Button Content="隠す（承認）" Click="Approve_Click"/>
                            <Button Content="無視（却下）" Click="Reject_Click"/>
                            <Button Content="保留" Click="Defer_Click"/>
                            <Button Content="AI判定レポートCSV" Click="ExportFeedback_Click"/>
                            <Button Content="加工画像を保存" Click="SaveImage_Click" Background="#147F80" Foreground="White"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding ModelStatus}" Margin="6,3,0,0" Foreground="#FFD29B" FontSize="12"/>
                        <WrapPanel Margin="2,6,0,0" VerticalAlignment="Center">
                            <TextBlock Text="マスク方式：" VerticalAlignment="Center"/>
                            <ComboBox x:Name="MaskStyleCombo" Width="115" SelectedIndex="0" Margin="4,0,12,0"
                                      SelectionChanged="MaskStyleCombo_SelectionChanged">
                                <ComboBoxItem Content="モザイク"/>
                                <ComboBoxItem Content="ぼかし"/>
                                <ComboBoxItem Content="黒塗り"/>
                            </ComboBox>
                            <TextBlock Text="強さ：" VerticalAlignment="Center"/>
                            <Slider x:Name="StrengthSlider" Width="115" Minimum="4" Maximum="64"
                                    Value="20" TickFrequency="4" IsSnapToTickEnabled="True"
                                    ValueChanged="StrengthSlider_ValueChanged" Margin="4,0,4,0"/>
                            <TextBlock Text="{Binding ElementName=StrengthSlider,Path=Value,StringFormat=F0}"
                                       VerticalAlignment="Center" Width="28"/>
                            <TextBlock Text="切り取り拡大：" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Button Content="1x" Click="Zoom1_Click"/>
                            <Button Content="2x" Click="Zoom2_Click"/>
                            <Button Content="4x" Click="Zoom4_Click"/>
                            <Button Content="8x" Click="Zoom8_Click"/>
                            <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="左の検出枠は内部ドラッグで移動、角の□でサイズ変更"
                                       Foreground="#B4BFCA" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0D1015" BorderBrush="#353B48" BorderThickness="1" Margin="0,0,6,0">
                            <Grid>
                                <Image x:Name="MainImageView" Source="{Binding MainImage}" Stretch="Uniform"/>
                                <Canvas x:Name="PreviewCanvas" Background="Transparent"
                                        SizeChanged="PreviewCanvas_SizeChanged"
                                        MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                                        MouseMove="PreviewCanvas_MouseMove"
                                        MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp"
                                        LostMouseCapture="PreviewCanvas_LostMouseCapture"/>
                                <Border Background="#A010151C" VerticalAlignment="Top" HorizontalAlignment="Left"
                                        Padding="8,5" Margin="8" IsHitTestVisible="False">
                                    <TextBlock Text="元画像（枠をドラッグして修正）" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="#0D1015" BorderBrush="#353B48" BorderThickness="1" Margin="0,0,6,0">
                            <Grid>
                                <Image Source="{Binding ProcessedImage}" Stretch="Uniform"/>
                                <Border Background="#A010151C" VerticalAlignment="Top" HorizontalAlignment="Left"
                                        Padding="8,5" Margin="8" IsHitTestVisible="False">
                                    <TextBlock Text="加工プレビュー（承認領域のみ・縮小表示）" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="#0D1015" BorderBrush="#353B48" BorderThickness="1">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="10,8" Background="#242A36">
                                    <TextBlock Text="検出箇所の切り取り・拡大" FontWeight="SemiBold"/>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Background="#0D1015" CanContentScroll="False">
                                    <Image x:Name="CropImageView" Source="{Binding CropImage}" Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#353B48" BorderThickness="1" Background="#202530">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="確認キュー（切り取り一覧）" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="  候補をクリックして右側を拡大／元画像の枠を移動・編集できます。"
                                           FontSize="12" VerticalAlignment="Center" Foreground="#AEB7C7"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                     SelectionChanged="Candidates_SelectionChanged" Background="#131822" Foreground="#E8E8EE"
                                     ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="Auto" MinHeight="88" Margin="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#080C12" BorderBrush="#384456"
                                                    BorderThickness="1" Width="98" Height="78">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ConfidenceText}" Foreground="#FFD29B" FontSize="11" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding RegionText}" Foreground="#AAB5C6" FontSize="11" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="VideoTab" Header="動画・追従編集（R3.3）">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="190"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <WrapPanel>
                            <Button Content="動画を開く" Click="VideoOpen_Click"/>
                            <Button Content="この時刻を表示" Click="VideoSeek_Click"/>
                            <Button Content="−1コマ（索引／推定）" Click="VideoPreviousFrame_Click"/>
                            <Button Content="＋1コマ（索引／推定）" Click="VideoNextFrame_Click"/>
                            <Button Content="−1秒" Click="VideoPreviousSecond_Click"/>
                            <Button Content="＋1秒" Click="VideoNextSecond_Click"/>
                            <Button Content="区間の開始に設定" Click="VideoMarkStart_Click"/>
                            <Button Content="区間の終了に設定" Click="VideoMarkEnd_Click"/>
                            <Button Content="選択範囲を候補登録" Click="VideoAddCandidate_Click"/>
                            <Button Content="現在フレームをAI解析" Click="VideoDetectFrame_Click"/>
                            <Button Content="フレーム時刻を索引化" Click="VideoIndexFrames_Click"/>
                            <TextBlock Text="全動画AIサンプル走査：" VerticalAlignment="Center" Margin="9,0,2,0"/>
                            <ComboBox x:Name="VideoScanRateCombo" Width="140" SelectedIndex="1" VerticalAlignment="Center">
                                <ComboBoxItem Content="1 fps"/>
                                <ComboBoxItem Content="2 fps"/>
                                <ComboBoxItem Content="4 fps"/>
                                <ComboBoxItem Content="8 fps（高密度）"/>
                                <ComboBoxItem Content="12 fps（高密度）"/>
                            </ComboBox>
                            <Button x:Name="VideoScanButton" Content="全動画をサンプル走査" Click="VideoScanAll_Click"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="隠す（承認）" Click="VideoApprove_Click"/>
                            <Button Content="無視（却下）" Click="VideoReject_Click"/>
                            <Button Content="保留" Click="VideoDefer_Click"/>
                            <Button Content="候補を削除" Click="VideoDelete_Click"/>
                            <Button Content="この時刻に追従点を追加・更新" Click="VideoKeyframeAdd_Click"/>
                            <Button Content="この時刻の追従点を削除" Click="VideoKeyframeRemove_Click"/>
                            <TextBlock Text="追従提案：" VerticalAlignment="Center" Margin="12,0,2,0"/>
                            <ComboBox x:Name="VideoTrackRateCombo" Width="78" SelectedIndex="1" VerticalAlignment="Center">
                                <ComboBoxItem Content="8 fps"/>
                                <ComboBoxItem Content="12 fps"/>
                            </ComboBox>
                            <Button x:Name="VideoTrackProposeButton" Content="追従を自動提案（実験）" Click="VideoTrackPropose_Click"/>
                            <Button x:Name="VideoTrackApplyButton" Content="提案を確認して適用" IsEnabled="False" Click="VideoTrackApply_Click"/>
                            <Button Content="レビュー情報を保存" Click="VideoSaveProject_Click"/>
                            <Button Content="承認した区間を黒塗りMP4出力" Background="#147F80"
                                    Foreground="White" Click="VideoExport_Click"/>
                            <Button Content="処理を中止" Click="VideoCancel_Click"/>
                            <TextBlock x:Name="VideoStatusText" Margin="8,7,0,0" Foreground="#FFD29B"
                                       Text="動画を開いてください。FFmpeg/FFprobeが必要です。" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="4,5,4,5">
                        <ProgressBar x:Name="VideoScanProgress" Minimum="0" Maximum="100" Height="5" Value="0" Margin="0,0,0,4"/>
                        <TextBlock x:Name="VideoMetaText" Text="未読み込み" Foreground="#AEB7C7" FontSize="12"/>
                        <TextBlock x:Name="VideoRangeText" Text="区間：未指定 / 映像上をドラッグして候補を指定"
                                   Foreground="#BCE0F4" FontSize="12"/>
                        <TextBlock x:Name="VideoTrackText" Text="選択候補：なし。追従点は映像上をドラッグ→追加で設定。"
                                   Foreground="#D8D29A" FontSize="12"/>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="4,4,4,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="VideoTimelineSlider" Minimum="0" Maximum="1" Value="0"
                                IsSnapToTickEnabled="False" VerticalAlignment="Center"
                                ValueChanged="VideoTimeline_ValueChanged"/>
                        <TextBlock x:Name="VideoTimeText" Grid.Column="1" Text="0.000s / 0.000s"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0D1015" BorderBrush="#353B48" BorderThickness="1" Margin="0,0,8,0">
                            <Grid>
                                <Image x:Name="VideoFrameImage" Stretch="Uniform"/>
                                <Canvas x:Name="VideoFrameCanvas" Background="Transparent"
                                        MouseLeftButtonDown="VideoFrameCanvas_MouseLeftButtonDown"
                                        MouseMove="VideoFrameCanvas_MouseMove"
                                        MouseLeftButtonUp="VideoFrameCanvas_MouseLeftButtonUp"
                                        LostMouseCapture="VideoFrameCanvas_LostMouseCapture"
                                        SizeChanged="VideoFrameCanvas_SizeChanged"/>
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#A010151C"
                                        Padding="8,5" Margin="8" IsHitTestVisible="False">
                                    <TextBlock Text="動画フレーム（矩形をドラッグして範囲指定）" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="#0D1015" BorderBrush="#353B48" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Background="#242A36" Orientation="Horizontal">
                                    <TextBlock Text="選択候補の拡大" Margin="8" VerticalAlignment="Center"/>
                                    <Button Content="1x" Click="VideoZoom1_Click"/>
                                    <Button Content="2x" Click="VideoZoom2_Click"/>
                                    <Button Content="4x" Click="VideoZoom4_Click"/>
                                    <Button Content="8x" Click="VideoZoom8_Click"/>
                                </StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Image x:Name="VideoCropImage" Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="4" Background="#202530" BorderBrush="#353B48" BorderThickness="1" Margin="0,8,0,0">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="確認キュー：追従提案は検証前に保存されません。途切れを検出したら適用不可、手動修正してください。"
                                       Foreground="#B6C3D2" Margin="0,0,0,6"/>
                            <ListBox x:Name="VideoCandidateList" SelectionChanged="VideoCandidates_SelectionChanged"
                                     DisplayMemberPath="Display" Background="#131822" Foreground="#E8E8EE"
                                     VirtualizingStackPanel.IsVirtualizing="True"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="フォルダ一括（R4.2）">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="160"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <WrapPanel>
                            <Button Content="フォルダ選択" Click="BatchSelectFolder_Click"/>
                            <CheckBox x:Name="BatchRecursiveCheck" Content="サブフォルダも対象" IsChecked="True"
                                      VerticalAlignment="Center" Margin="10,0"/>
                            <Button x:Name="BatchScanButton" Content="ファイルをスキャン" Click="BatchScan_Click"/>
                            <Button x:Name="BatchRunButton" Content="AI一括解析／再開" Click="BatchRun_Click"
                                    Background="#147F80" Foreground="White"/>
                            <Button Content="中止" Click="BatchCancel_Click"/>
                            <Button Content="エラーのみ再試行" Click="BatchRetryFailed_Click"/>
                            <Button Content="全件再解析" Click="BatchResetAll_Click"/>
                            <Button Content="選択ファイルを確認画面で開く" Click="BatchOpenForReview_Click"/>
                            <Button Content="出力先選択" Click="BatchChooseOutput_Click"/>
                            <Button x:Name="BatchExportButton" Content="承認済みを一括書き出し" Click="BatchExport_Click"
                                    Background="#147F80" Foreground="White"/>
                            <Button Content="選択した出力を比較" Click="BatchShowCompare_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="BatchOutputFolderText" Text="出力先未選択" FontSize="12"
                                   Foreground="#B6E3D5" Margin="6,4" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BatchFolderText" Text="フォルダ未選択" FontSize="12"
                                   Foreground="#AEB7C7" Margin="6,4" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="4,10">
                        <ProgressBar x:Name="BatchProgress" Minimum="0" Maximum="100" Height="12"/>
                        <TextBlock x:Name="BatchSummaryText" Text="対象ファイルをスキャンしてください。"
                                   Foreground="#B6C3D2" Margin="0,8,0,0"/>
                        <TextBlock x:Name="BatchStatusText" Text="モデルを読み込まない場合はファイル一覧の作成のみできます。"
                                   Foreground="#FFD29B" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="出力には承認済みのマスクが必要です。未確認／保留があるファイルは書き出しません。1fps間引き走査では検出漏れがあります。原本は上書きしません。"
                               Foreground="#FFD29B" TextWrapping="Wrap" Margin="4,0,4,8"/>
                    <ListBox Grid.Row="3" x:Name="BatchJobsList" DisplayMemberPath="Display"
                             Background="#131822" Foreground="#E8E8EE" Margin="4"
                             ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                    <DockPanel Grid.Row="4" Margin="4,8,4,0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="一括加工・書き出しの結果（確認済み候補だけ）" FontWeight="Bold"/>
                            <TextBlock x:Name="BatchExportSummaryText" Text="出力待ち" Foreground="#B6C3D2"/>
                        </StackPanel>
                        <ListBox x:Name="BatchExportList" SelectionChanged="BatchExportList_SelectionChanged" DisplayMemberPath="Display" Background="#131822"
                                 Foreground="#E8E8EE" VirtualizingStackPanel.IsVirtualizing="True"/>
                    </DockPanel>

                </Grid>
            </TabItem>
            <TabItem x:Name="BatchCompareTab" Header="出力比較（R4.2）">
                    <Border Margin="14" Padding="8" Background="#202530" BorderBrush="#353B48" BorderThickness="1">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <TextBlock Text="加工前後を比較（元データ・出力データ）" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,16,0"/>
                                <TextBlock Text="動画の時刻（秒）" VerticalAlignment="Center"/>
                                <TextBox x:Name="BatchCompareSecondsText" Text="0" Width="60" Margin="5,0,10,0" VerticalContentAlignment="Center"/>
                                <Button x:Name="BatchCompareButton" Content="選択した出力を比較" Click="BatchCompare_Click"/>
                                <Button x:Name="BatchMarkComparedButton" Content="表示サンプルの確認を記録" Click="BatchMarkCompared_Click" IsEnabled="False"/>
                            </WrapPanel>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="BatchCompareStatusText" Margin="4,4,0,0" TextWrapping="Wrap"
                                       Foreground="#FFD29B" Text="出力済みファイルを選び、比較ボタンを押してください。動画は指定時刻の静止画比較です（安全保証ではありません）。"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="#353B48" BorderThickness="1" Margin="0,0,4,0" Background="#0D1015">
                                    <Grid>
                                        <Image x:Name="BatchCompareBeforeImage" Stretch="Uniform"/>
                                        <TextBlock Text="元ファイル" Foreground="#FFFFFF" Background="#990D1015" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="#353B48" BorderThickness="1" Margin="4,0,0,0" Background="#0D1015">
                                    <Grid>
                                        <Image x:Name="BatchCompareAfterImage" Stretch="Uniform"/>
                                        <TextBlock Text="加工済み出力" Foreground="#FFFFFF" Background="#990D1015" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>
            </TabItem>
            <TabItem Header="配信・OBS（R5予定）">
                <TextBlock Text="配信出力・遅延バッファー・フェイルセーフはR5で実装予定です。" Margin="20"/>
            </TabItem>
            <TabItem Header="設定・実装状況">
                <StackPanel Margin="20">
                    <TextBlock Text="R4.2：書き出し前後の比較表示と動画レビュー内容のSHA-256確認。R4.1：一括出力。R4.0：フォルダ一括解析と再開。R3.3：追従候補提案。解析結果は未確認で保存。" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="専用AIモデルは未同梱。互換ONNXモデルと定義JSONが必要。一般的な人物検出モデルは露出を検出しません。" Margin="0,14,0,0"/>
                    <TextBlock Text="対応画像：JPEG / PNG / BMP / TIFF / GIF先頭フレーム（環境に依存）" Margin="0,9,0,0"/>
                    <TextBlock Text="出力：画像PNG／動画MP4（黒塗り追従点補間）。サンプル間の見逃し・AI追跡の正確性は未保証。元データ上書き禁止。" Margin="0,9,0,0"/>
                    <TextBlock Text="判定履歴：%LOCALAPPDATA%\AIPrivacyGuard\history.sqlite" Margin="0,9,0,0"/>
                    <TextBlock Text="CSV集計はAI候補のみ（模擬・手動候補を除外）。正確な精度や見逃し率ではありません。" Margin="0,9,0,0"/>
                    <TextBlock Text="切り取り画像：メモリ内のみで表示。動画レビューの位置・判定はローカルJSON保存。" Margin="0,9,0,0"/>
                    <TextBlock Text="※ WPFの実機ビルド・動作テストはWindows環境で実施してください。" Margin="0,20,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="ValidationLabTab" Header="検証ラボ（R8.3試験版）" Loaded="LabTab_Loaded">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="X素材ブラウザ（API不要・手動閲覧）"/>
                            <TextBlock Margin="0,4,0,5" TextWrapping="Wrap" Foreground="#FFD29B"
                                       Text="通常のXを表示します。画像や動画の自動抽出・ダウンロードはしません。権利が確認できたローカル素材のみ検証用に登録してください。"/>
                            <WrapPanel>
                                <TextBox x:Name="LabXSearchText" Width="260" Margin="3" VerticalContentAlignment="Center"
                                         ToolTip="Xのユーザー名または検索キーワード"/>
                                <ComboBox x:Name="LabXMediaKind" Width="100" Margin="3" SelectedIndex="0">
                                    <ComboBoxItem Content="すべて"/>
                                    <ComboBoxItem Content="画像"/>
                                    <ComboBoxItem Content="動画"/>
                                </ComboBox>
                                <Button Content="Xで検索" Click="LabSearchX_Click"/>
                                <Button Content="ユーザーを見る" Click="LabUserX_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,4,0,8">
                            <Button Content="戻る" Click="LabBack_Click"/>
                            <Button Content="進む" Click="LabForward_Click"/>
                            <Button Content="再読込" Click="LabRefresh_Click"/>
                            <Button Content="外部ブラウザで開く" Click="LabExternal_Click"/>
                            <Button Content="表示中の投稿URLを登録" Click="LabBookmarkCurrent_Click"/>
                            <TextBlock VerticalAlignment="Center" Margin="6,0" FontSize="11" Foreground="#AEB7C7"
                                       Text="X APIリクエストなし"/>
                        </WrapPanel>
                        <Border Grid.Row="2" Background="#0D1015" BorderBrush="#353B48" BorderThickness="1">
                            <Grid>
                                <wv2:WebView2 x:Name="LabXBrowser"/>
                                <TextBlock x:Name="LabBrowserFallbackText" Visibility="Collapsed" Background="#151820"
                                           Foreground="#FFD29B" TextWrapping="Wrap" Padding="15"
                                           Text="WebView2が利用できません。外部ブラウザでXを開いてください。"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="3" x:Name="LabCurrentUrlText" Margin="4,6,4,0" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Foreground="#AEB7C7"
                                   Text="Xを表示しているURLのみ表示します。ページ内容を収集しません。"/>
                    </Grid>
                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="ローカル検証プロジェクト" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LabProjectPathText" Foreground="#B6C3D2" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,5,0,5"/>
                            <CheckBox x:Name="LabRightsConfirmed" Content="この素材を検証に使う権利・許可を確認した"
                                      Margin="3,4,0,5" Foreground="#FFD29B"/>
                            <WrapPanel>
                                <ComboBox x:Name="LabVisualDomain" Width="120" SelectedIndex="0" Margin="3">
                                    <ComboBoxItem Content="分類未指定"/>
                                    <ComboBoxItem Content="2Dイラスト"/>
                                    <ComboBoxItem Content="3Dモデル"/>
                                    <ComboBoxItem Content="実写"/>
                                </ComboBox>
                                <Button Content="画像・動画を登録" Click="LabImportLocal_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,7,0,5">
                            <Button Content="元ファイルを開く" Click="LabOpenLocal_Click"/>
                            <Button Content="目視確認：対象なし" Click="LabMarkNegative_Click"/>
                            <Button Content="判断保留" Click="LabMarkUncertain_Click"/>
                            <Button Content="判定を元に戻す" Click="LabUndo_Click"/>
                        </WrapPanel>
                        <ListBox Grid.Row="2" x:Name="LabLocalSourcesList"
                                 Background="#131822" Foreground="#E8E8EE" Margin="2"
                                 DisplayMemberPath="Display"/>
                        <StackPanel Grid.Row="3" Margin="0,8,0,4">
                            <TextBlock Text="X投稿URLの参考リンク（投稿の画像・動画は保存しません）"
                                       TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/>
                            <TextBox x:Name="LabManualPostUrl" Margin="2,6" ToolTip="https://x.com/ユーザー名/status/投稿ID"
                                     Text=""/>
                            <WrapPanel>
                                <Button Content="URLを登録" Click="LabBookmarkUrl_Click"/>
                                <Button Content="選択した投稿を開く" Click="LabOpenBookmark_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <ListBox Grid.Row="4" x:Name="LabBookmarksList" Background="#131822"
                                 Foreground="#E8E8EE" Margin="2" DisplayMemberPath="Display"/>
                        <TextBlock Grid.Row="5" x:Name="LabStatusText" Margin="2,10,2,0"
                                   TextWrapping="Wrap" Foreground="#AEE7E4"
                                   Text="画像の詳細な領域ラベル・動画コマ送りは次の実装段階です。"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="LiveBridgeTab" Header="OBS連携（実験）">
                <StackPanel Margin="22" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontWeight="SemiBold" FontSize="18"
                               Text="OBS Browser Source — 合成映像で接続確認"/>
                    <TextBlock Margin="0,8,0,12" Foreground="#FFD29B" TextWrapping="Wrap"
                               Text="これは検証用機能です。露出検出モデルは同梱しておらず、実際の配信事故防止には使用できません。"/>
                    <WrapPanel>
                        <Button Content="合成映像デモを起動" Click="StartDemoLiveBridge_Click"/>
                        <Button Content="OBSブリッジを停止" Click="StopLiveBridge_Click"/>
                        <Button Content="OBS URLをコピー" Click="CopyObsBrowserUrl_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="LiveBridgeStatus" Text="停止中。開始前の出力は黒画面です。"
                               Foreground="#AEE7E4" Margin="4,12,0,6" TextWrapping="Wrap"/>
                    <TextBox x:Name="LiveBridgeUrl" IsReadOnly="True" Margin="4"
                             Text="デモを起動するとOBS用URLを表示します。" />
                    <TextBlock Margin="4,10,0,0" Foreground="#AEB7C7" TextWrapping="Wrap"
                               Text="OBSで「ブラウザ」ソースを追加し、上のURLを指定してください。推奨サイズ：640×360。カメラ入力・音声同期の実験機能は別のLiveBridge.exeのコマンドラインで操作します。"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
